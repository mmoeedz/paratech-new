# Required for the contact form to actually deliver enquiries.
# Sign up at https://resend.com, verify a sending domain, and paste the key here.
RESEND_API_KEY=

# Optional overrides — defaults live in src/lib/site.ts and this file's comments.
# Inbox that receives new enquiries (defaults to SITE.email).
CONTACT_TO_EMAIL=hello@paratech.agency
# Verified "from" address used for both the team notification and the visitor
# confirmation email. Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=Paratech <onboarding@resend.dev>

# Canonical site URL used for metadata and structured data.
NEXT_PUBLIC_SITE_URL=https://paratech.agency
